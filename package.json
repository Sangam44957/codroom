{
  "name": "codroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:socket": "node server/socket.mjs",
    "dev:worker": "node server/aiReportWorker.js",
    "dev:all": "npx kill-port 3000 3001 && concurrently -k -r -n NEXT,SOCKET,WORKER -c cyan,yellow,green \"npm run dev\" \"npm run dev:socket\" \"npm run dev:worker\"",
    "kill:ports": "npx kill-port 3000 3001",
    "start:clean": "npm run kill:ports && npm run dev:all",
    "build": "prisma generate && next build",
    "build:all": "prisma generate && next build",
    "build:docker": "docker build -t codroom-app -f Dockerfile.prod . && docker build -t codroom-socket -f Dockerfile.socket .",
    "build:sandbox": "bash scripts/build-sandbox-images.sh",
    "start": "next start",
    "start:socket": "node server/socket.mjs",
    "start:worker": "node server/aiReportWorker.js",
    "start:all": "concurrently -k -r -n NEXT,SOCKET,WORKER -c cyan,yellow,green \"npm run start\" \"npm run start:socket\" \"npm run start:worker\"",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:smoke": "jest --testPathPattern=smoke",
    "seed": "node prisma/seed.cjs",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "deploy:staging": "./scripts/deploy.sh staging",
    "deploy:production": "./scripts/deploy.sh production",
    "monitoring:up": "docker compose -f docker-compose.monitoring.yml up -d || docker-compose -f docker-compose.monitoring.yml up -d",
    "monitoring:down": "docker compose -f docker-compose.monitoring.yml down || docker-compose -f docker-compose.monitoring.yml down",
    "security:scan": "npm audit && docker run --rm -v $(pwd):/app securecodewarrior/docker-security-scan /app",
    "performance:test": "k6 run scripts/load-test.js",
    "backup:db": "pg_dump $DATABASE_URL | gzip > backup-$(date +%Y%m%d).sql.gz",
    "health:check": "curl -f $NEXT_PUBLIC_APP_URL/api/health"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "jsdom",
        "testMatch": [
          "**/__tests__/**/*.test.js"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "socket\\.integration\\.test\\.js",
          "executor\\.test\\.js"
        ],
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1"
        },
        "transform": {
          "^.+\\.(js|jsx)$": ["babel-jest", {"configFile": "./babel.config.test.js"}]
        },
        "transformIgnorePatterns": [
          "node_modules/(?!(jose|next|@babel/runtime)/)"
        ],
        "setupFiles": [
          "<rootDir>/src/__tests__/setup.js"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/src/__tests__/setupTests.js"
        ],
        "testEnvironmentOptions": {
          "url": "http://localhost:3000"
        }
      },
      {
        "displayName": "socket-integration",
        "testEnvironment": "node",
        "testMatch": [
          "**/__tests__/socket.integration.test.js"
        ],
        "transform": {
          "^.+\\.(js|jsx)$": ["babel-jest", {"configFile": "./babel.config.test.js"}]
        },
        "transformIgnorePatterns": [
          "node_modules/(?!(jose)/)"
        ],
        "setupFiles": [
          "<rootDir>/src/__tests__/setup.js"
        ]
      },
      {
        "displayName": "executor",
        "testEnvironment": "node",
        "testMatch": [
          "**/__tests__/executor.test.js"
        ],
        "transform": {
          "^.+\\.(js|jsx)$": ["babel-jest", {"configFile": "./babel.config.test.js"}]
        },
        "transformIgnorePatterns": [
          "node_modules/"
        ],
        "setupFiles": [
          "<rootDir>/src/__tests__/setup.js"
        ]
      }
    ]
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.48.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@upstash/redis": "^1.37.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.38.0",
    "groq-sdk": "^1.1.1",
    "jose": "^6.2.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.4",
    "peerjs": "^1.5.5",
    "pino": "^10.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "redis": "^5.12.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@jest/globals": "^30.3.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.2.14",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-environment-node": "^30.3.0",
    "kill-port": "^2.0.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^4"
  }
}
